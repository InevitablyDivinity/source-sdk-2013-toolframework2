//-----------------------------------------------------------------------------
//	SAMPLETOOL.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_base.vpc"
$Include "$SRCDIR\thirdparty\qt-6.9\qt-6.9.vpc"

$Configuration
{
	$Linker
	{
		$SystemLibraries "$BASE;SDL2" [$LINUXALL]
	}
}

$Project "sampletool"
{
	$Folder	"Source Files"
	{
		$File "sampletool.cpp" \
		      "materialsystem_window.cpp" \
		      "model_view_window.cpp" \
		      "particle_view_window.cpp" \
		      "ui.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$AdditionalOptions "$BASE $QT_CXXFLAGS" [$WINDOWS]
				}
			}
		}

		$DynamicFile "materialsystem_window_moc.cpp" \
		             "model_view_window_moc.cpp" \
		             "particle_view_window_moc.cpp" \
		             "ui_moc.cpp"
		{
			$Configuration
			{
				$Compiler
				{
					$AdditionalOptions "$BASE $QT_CXXFLAGS" [$WINDOWS]
				}
			}
		}

		$File "materialsystem_window.h" \
		      "model_view_window.h" \
		      "particle_view_window.h" \
		      "ui.h"
		{
			$Configuration
			{
				$CustomBuildStep
				{
					$CommandLine "$MOC_COMMAND"
					$Outputs "$MOC_OUTPUT"
				}
			}
		}

		$Folder	"Common Files"
		{
			$File "$SRCDIR/public/materialsystem/MaterialSystemUtil.cpp"
			$File "$SRCDIR/public/filesystem_init.cpp"
			$File "$SRCDIR/public/studio.cpp"
			$File "$SRCDIR/public/bone_setup.cpp"
			$File "$SRCDIR/public/collisionutils.cpp"
		}
	}

	$Folder	"Header Files"
	{
	}

	$Folder "Link Libraries"
	{
		$ImpLib "$LIBPUBLIC/tier0"
		$ImpLib "$LIBPUBLIC/vstdlib"
		$ImpLib "togl" [$LINUX]
		$Lib "mathlib"
		$Lib "tier1"
		$Lib "tier2"
		$Lib "tier3"
		$Lib "toolframework2"
		$Lib "appframework"
		$Lib "particles"
		$Lib "dmxloader"
	}
}
