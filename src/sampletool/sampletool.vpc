//-----------------------------------------------------------------------------
//	SAMPLETOOL.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Macro SRCDIR		".."
$Macro GENERATED_MOC_DIR "."
$Macro OUTBINDIR	"$SRCDIR\..\game\bin"

$Include "$SRCDIR\vpc_scripts\source_exe_base.vpc"
$Include "$SRCDIR\thirdparty\qt-6.12\qt-6.12.vpc"

$Configuration
{
	$Linker
	{
		$SystemLibraries "$BASE;SDL2" [$LINUXALL]
	}
}

$Project "sampletool"
{
	$Folder	"Source Files"
	{
		$File "sampletool.cpp"

		$File "materialsystem_window.cpp"
		$File "materialsystem_window.h"
		$DynamicFile "materialsystem_window.h.moc"

		$File "model_view_window.cpp"
		$File "model_view_window.h"
		$DynamicFile "model_view_window.h.moc"

		$File "particle_view_window.cpp"
		$File "particle_view_window.h"
		$DynamicFile "particle_view_window.h.moc"

		$File "ui.cpp"
		$File "ui.h"
		$DynamicFile "ui.h.moc"

		$Folder	"Common Files"
		{
			$File "$SRCDIR/public/materialsystem/MaterialSystemUtil.cpp"
			$File "$SRCDIR/public/filesystem_init.cpp"
			$File "$SRCDIR/public/studio.cpp"
			$File "$SRCDIR/public/bone_setup.cpp"
			$File "$SRCDIR/public/collisionutils.cpp"
		}
	}

	$Folder	"Header Files"
	{
	}

	$Folder "Link Libraries"
	{
		$ImpLib "$LIBPUBLIC/tier0"
		$ImpLib "$LIBPUBLIC/vstdlib"
		$ImpLib "togl" [$LINUX]
		$Lib "mathlib"
		$Lib "tier1"
		$Lib "tier2"
		$Lib "tier3"
		$Lib "toolframework2"
		$Lib "appframework"
		$Lib "particles"
		$Lib "dmxloader"
	}
}
