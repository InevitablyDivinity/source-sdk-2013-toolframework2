//-----------------------------------------------------------------------------
//	QT-6.12.VPC
//
//	Project Script
//-----------------------------------------------------------------------------

$Conditional USE_SYSTEM_QT 1

$MacroRequired GENERATED_MOC_DIR
$Macro QT_ROOT "/usr"
$Macro MOC_EXE "$QT_ROOT/lib/qt6/moc"

$CustomBuildStep "moc"
{
	$AdditionalDependencies "$(InputDir)/$(InputName)"
	$CommandLine	"$MOC_EXE --compiler-flavor unix $(InputDir)/$(InputName) -o $(InputDir)/$(InputFileName)"
	$Description	"$(InputName) produces $(InputDir)$(InputFileName)"
	$Outputs		"$(InputDir)/$(InputFileName)"
}

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;$GENERATED_MOC_DIR"
		$AdditionalIncludeDirectories	"$BASE;$QT_ROOT/qt6;$QT_ROOT/qt6/QtCore;$QT_ROOT/qt6/QtGui;$QT_ROOT/qt6/QtWidgets" [!$USE_SYSTEM_QT]
		$AdditionalIncludeDirectories	"$BASE;$QT_ROOT/include/qt6;$QT_ROOT/include/qt6/QtCore;$QT_ROOT/include/qt6/QtGui;$QT_ROOT/include/qt6/QtWidgets; -std=c++17;" [$USE_SYSTEM_QT]
		$PreprocessorDefinitions		"$BASE;QT_GUI_LIB;QT_CORE_LIB;QT_WIDGETS_LIB"
	}

	$Linker
	{
		// Link tier0 first because Qt needs our allocators during static object initization!
		$AdditionalDependencies			"$BASE;$LIBPUBLIC/tier0.lib"
	}


	$CustomBuildStep
	{
		// General
		$CommandLine
		$Description
		$Outputs
		$AdditionalDependencies
	}
}

$Configuration "Debug"
{
	$Linker
	{
		$SystemLibraries				"$BASE;Qt6Cored;Qt6Guid;Qt6Widgetsd" [$USE_SYSTEM_QT]
	}
}

$Configuration "Release"
{
	$Linker
	{
		$SystemLibraries				"$BASE;Qt6Core;Qt6Gui;Qt6Widgets" [$USE_SYSTEM_QT]
	}
}

